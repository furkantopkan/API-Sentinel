{
  "name": "api-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based REST API testing platform for QA engineers.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "client",
    "tools/mock-target"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=@api-sentinel/server",
    "dev:client": "npm run dev --workspace=@api-sentinel/client",
    "mock": "npm run start --workspace=@api-sentinel/mock-target",
    "start:server": "npm run start --workspace=@api-sentinel/server",
    "build": "npm run build --workspace=@api-sentinel/client",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test -c e2e",
    "traceability": "node scripts/traceability.mjs",
    "app:install": "node scripts/app.mjs install",
    "app:uninstall": "node scripts/app.mjs uninstall",
    "app:start": "node scripts/app.mjs start",
    "app:stop": "node scripts/app.mjs stop",
    "app:restart": "node scripts/app.mjs restart",
    "app:status": "node scripts/app.mjs status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
