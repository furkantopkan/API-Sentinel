# API Sentinel – environment template
# Copy this file to `.env` and adjust values. Never commit `.env`.

# --- Server ---
PORT=3001
# Bind only to the local machine by default
HOST=127.0.0.1

# --- Outbound request limits ---
REQUEST_TIMEOUT_DEFAULT_MS=15000
REQUEST_TIMEOUT_MAX_MS=60000
# 5 MB
RESPONSE_MAX_BYTES=5242880
# Max size of JSON bodies accepted by our own backend
REQUEST_BODY_LIMIT=1mb
MAX_REDIRECTS=5

# --- SSRF protection ---
# Comma-separated host:port pairs that bypass the private/loopback block.
# Leave empty unless you need to test a local API.
# Example for the local mock target: SSRF_ALLOWLIST=localhost:4010
SSRF_ALLOWLIST=

# --- AI (Phase 5) ---
# Backend only. Never expose this to the client.
ANTHROPIC_API_KEY=
# auto = use Anthropic when ANTHROPIC_API_KEY is set, otherwise AI is off
# mock = built-in fake answers (no key, no cost) for trying the UI
AI_MODE=auto
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=medium
AI_TIMEOUT_MS=90000
AI_RATE_LIMIT_PER_MINUTE=10

# --- Storage (Phase 6) ---
# SQLite file for collections etc., relative to the project root (git-ignored)
DB_PATH=data/api-sentinel.db
