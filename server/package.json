{
  "name": "@api-sentinel/server",
  "version": "0.1.0",
  "private": true,
  "description": "API Sentinel backend: validates, secures and forwards HTTP requests.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=html --coverage.include=src/**"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@api-sentinel/shared": "*",
    "express": "^5.3.0",
    "playwright": "^1.65.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@api-sentinel/mock-target": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
