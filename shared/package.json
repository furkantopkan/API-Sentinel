{
  "name": "@api-sentinel/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types and Zod schemas shared by client and server (the API contract).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=html --coverage.include=src/**"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
