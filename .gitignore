# Dependencies (re-installable with `npm install`)
node_modules/

# Environment files: real secrets must never be committed.
# Only the template (.env.example) is tracked.
.env
.env.*
!.env.example

# Build output (re-generated from source)
dist/
build/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/

# Local databases (Phase 6)
*.db
*.db-journal

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
